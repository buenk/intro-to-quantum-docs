---
// Replaces starlight-theme-black's <Head>: same head entries, but loads Space Grotesk (UI and
// headings), Libron (reading text) and Geist Mono (code) instead of Geist Sans. Registered by the `qdocs-head` plugin in
// astro.config.mjs, after the theme plugin.
import { Font } from 'astro:assets';

const { head } = Astro.locals.starlightRoute;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<Font cssVariable="--font-space-grotesk" preload />
<Font cssVariable="--font-libron" preload />
<Font cssVariable="--font-geist-mono" />
